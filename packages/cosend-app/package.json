{
  "name": "cosend-app",
  "version": "1.0.0",
  "description": "Node SDK for Cosend: verify Cosend's signed WhatsApp webhooks and call the Cosend REST API (send a message, list conversations) with zero dependencies. Your existing WhatsApp Business number, kept on the phone, through Meta's official Cloud API.",
  "keywords": [
    "cosend",
    "whatsapp",
    "whatsapp-business",
    "whatsapp-business-api",
    "whatsapp-cloud-api",
    "whatsapp-api",
    "coexistence",
    "webhook",
    "webhook-signature",
    "hmac",
    "sdk",
    "shared-inbox",
    "mcp"
  ],
  "homepage": "https://cosend.app/docs/api",
  "bugs": {
    "url": "https://github.com/cosendhq/cosend-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosendhq/cosend-node.git",
    "directory": "packages/cosend-app"
  },
  "license": "MIT",
  "author": "True North Tech Group LLC",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/webhooks.test.mjs test/client.test.mjs test/build.test.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
